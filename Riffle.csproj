<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Riffle</AssemblyName>
    <RootNamespace>Riffle</RootNamespace>
    <Product>Riffle</Product>
    <Version>1.0.0</Version>
    <Company>Andrea Parolini</Company>
    <Authors>Andrea Parolini</Authors>
    <Description>Instant photo and video viewer for Windows</Description>
    <Copyright>Copyright (c) 2026 Andrea Parolini. CC BY-NC-ND 4.0</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>riffle.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- avvio rapido -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8602;CS8604;CA1416;NU1701</NoWarn>
    <!-- solo i binari VLC a 64 bit -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.1.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="riffle.ico" />
    <Resource Include="assets/riffle-32.png" />
    <Resource Include="assets/riffle-512.png" />
  </ItemGroup>

</Project>
